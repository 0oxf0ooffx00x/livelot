# ---------- LiveLot ----------
PORT=3000
# Seller token. REQUIRED on any public URL: without it anyone could reset the show or mark orders paid.
# Generate one with: openssl rand -hex 24. Open the dashboard once with /dashboard/?token=... (or sign in at /login/).
ADMIN_TOKEN=
# HTTPS URL that reaches this server (cloudflared/ngrok). Needed for webhooks, pay links and product images.
PUBLIC_BASE_URL=https://livelot.example.trycloudflare.com
SHOP_NAME="Rob's Vintage"
CURRENCY=GBP
CURRENCY_SYMBOL=£
CLAIM_TTL_SEC=900          # how long a buyer has to pay before the next in line gets it
STREAM_LAG_SEC=8           # viewers see the stream this many seconds late
AUTO_PUBLISH=false         # true = publish listings without the seller pressing Enter
DEV_TOOLS=true             # dashboard "Demo tools" menu and comment simulator

# Adapter modes default to mock unless the credentials below are set. Force with:
# PLATFORM=mock|meta  COMMERCE=mock|woo  AI=mock|meta

# ---------- Meta Model API (api.meta.ai) ----------
MODEL_API_KEY=
# SPARK_MODEL=muse-spark-1.3
# SAM_MODEL=sam-3.1          # pricing page says sam-3-1; try both
# ASR_MODEL=muse-voice-transcribe-1.0
# IMAGE_MODEL=muse-image-1.0
# CLEAN_THUMBNAILS=true
# ASR_KEYWORDS=Levi's,Nike,Air Max,Liberty

# ---------- Optional: Muse Spark Open on Baseten (first comment classifier, open weights; not used in our deployment) ----------
BASETEN_API_KEY=
# SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026

# ---------- Facebook / Instagram ----------
META_APP_ID=
META_APP_SECRET=           # verifies X-Hub-Signature-256 on webhooks
META_VERIFY_TOKEN=livelot-verify
FB_PAGE_ID=
FB_PAGE_TOKEN=             # Page token: pages_read_engagement, pages_read_user_content, pages_messaging, pages_manage_engagement
IG_USER_ID=
# IG_TOKEN=                # defaults to FB_PAGE_TOKEN (Facebook Login path)
# GRAPH_VERSION=v24.0
# FB_BUTTON_TEMPLATE=true  # Messenger button with the pay link (falls back to text)
# PUBLIC_WAITLIST_REPLY=true

# ---------- WooCommerce ----------
WOO_URL=https://shop.example.com
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
# WOO_QUERY_AUTH=true      # if the host strips the Authorization header
LIVELOT_PING_SECRET=change-me   # same as LIVELOT_SECRET in wp-config.php (mu-plugin)
# WOO_WEBHOOK_SECRET=      # optional Woo webhook (order.updated -> /webhooks/woo)

# Where the Settings screen saves what the seller types in (overrides the values above)
# SETTINGS_FILE=data/settings.json
