{
  "name": "livelot",
  "version": "0.1.0",
  "private": true,
  "description": "Sell on Facebook & Instagram Live. Say it, list it, 'sold' it, paid.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test 'test/*.test.js'",
    "replay": "node --env-file-if-exists=.env src/replay/run.js",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.js",
    "art": "node scripts/art-prep.js",
    "art:sheets": "node scripts/art-sheets.js"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  }
}
